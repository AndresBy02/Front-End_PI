# ==============================================================================
# SEGURIDAD Y CREDENCIALES (NUNCA SUBIR AL REPOSITORIO)
# ==============================================================================
# Variables de entorno y secretos
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Claves, certificados y credenciales de acceso
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
credentials.json
client_secrets*.json
token.json
tokens.json

# Cookies, sesiones, perfiles de navegador y almacenamiento web
**/Cookies
**/Cookies-journal
**/Session Storage/
**/Local Storage/
**/IndexedDB/
**/CacheStorage/
**/chrome-device/
**/edge-device/
**/Sync Data/
**/Sync Extension Settings/
**/Password_Diagnostics/
**/Secure Preferences
**/Preferences
**/*.cookie
**/*.session

# ==============================================================================
# NODE.JS & BACKEND
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Logs del servidor y volcados
logs/
*.log
npm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock

# ==============================================================================
# FLUTTER & DART
# ==============================================================================
.dart_tool/
**/.dart_tool/
build/
**/build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
**/.packages
*.dill
*.track.dill

# Flutter Windows / Desktop / Web ephemeral
ephemeral/
**/ephemeral/
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/

# ==============================================================================
# BASES DE DATOS LOCALES Y VOLCADOS
# ==============================================================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql.dump

# ==============================================================================
# IDEs Y SISTEMAS OPERATIVOS
# ==============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
